# Development Dockerfile with hot reload
FROM node:18-alpine

# Install nodemon globally
RUN npm install -g nodemon

# Set working directory
WORKDIR /app

# Copy package files
COPY package*.json ./

# Install all dependencies including dev dependencies
RUN npm install

# Copy source code
COPY . .

# Create data directories
RUN mkdir -p data/memory data/inbox/processed data/inbox/important data/inbox/spam logs

# Expose port
EXPOSE 3000

# Start with nodemon for hot reload
CMD ["npm", "run", "dev"]
