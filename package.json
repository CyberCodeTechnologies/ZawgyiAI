{
  "name": "zawgyiai",
  "version": "1.1.1",
  "description": "ZawgyiAI is an open-source personal AI assistant that runs locally on your devices. It works with WhatsApp, Telegram, Discord, and more—clearing your inbox, managing your calendar, and automating your workflows while you sleep.",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon src/index.js",
    "test": "jest",
    "docker:build": "docker-compose build",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f zawgyiai",
    "docker:clean": "docker-compose down -v && docker system prune -f"
  },
  "keywords": [
    "ai",
    "assistant",
    "automation",
    "email",
    "calendar",
    "chat"
  ],
  "author": "ZawgyiAI Team",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.6.2",
    "cheerio": "^1.0.0-rc.12",
    "cors": "^2.8.6",
    "csurf": "^1.11.0",
    "dotenv": "^16.6.1",
    "express": "^4.22.1",
    "express-rate-limit": "^8.2.1",
    "extract-zip": "^2.0.1",
    "fs-extra": "^11.3.3",
    "googleapis": "^128.0.0",
    "helmet": "^8.1.0",
    "iconv-lite": "^0.7.2",
    "imap": "^0.8.19",
    "imap-simple": "^5.1.0",
    "mailparser": "^3.6.9",
    "marked": "^11.1.1",
    "mathjs": "^15.1.0",
    "multer": "^2.0.2",
    "node-cron": "^3.0.3",
    "nodemailer": "^6.9.16",
    "openai": "^4.24.0",
    "puppeteer": "^22.15.0",
    "qrcode-terminal": "^0.12.0",
    "rss-parser": "^3.13.0",
    "telegraf": "^4.16.3",
    "whatsapp-web.js": "^1.34.6",
    "yauzl": "^3.2.0"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "nodemon": "^3.0.2"
  }
}
